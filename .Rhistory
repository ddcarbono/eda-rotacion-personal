alpha <- 0.05
ad.test(df$edad[df$estado == "Activo"])
ad.test(df$edad[df$estado == "Retirado"])
wilcox.test(edad ~ estado, data = df, conf.int = TRUE)
leveneTest(edad ~ estado, data = df)
t.test(edad ~ estado, data = df, var.equal = TRUE)   # varianzas iguales
t.test(edad ~ estado, data = df, var.equal = FALSE)  # Welch — varianzas desiguales
ad.test(df$antig_m[df$estado == "Activo"])
ad.test(df$antig_m[df$estado == "Retirado"])
wilcox.test(antig_m ~ estado, data = df, conf.int = TRUE)
leveneTest(antig_m ~ estado, data = df)
t.test(antig_m ~ estado, data = df, var.equal = TRUE)
t.test(antig_m ~ estado, data = df, var.equal = FALSE)
df %>%
group_by(nivel_función) %>%
summarise(
n             = n(),
AD_estadístico = ad.test(edad)$statistic,
AD_p_valor    = ad.test(edad)$p.value
)
kruskal.test(edad ~ nivel_función, data = df)
dunnTest(edad ~ nivel_función, data = df, method = "bonferroni")
df %>%
group_by(nivel_función) %>%
summarise(
n             = n(),
AD_estadístico = ad.test(antig_m)$statistic,
AD_p_valor    = ad.test(antig_m)$p.value
)
kruskal.test(antig_m ~ nivel_función, data = df)
dunnTest(antig_m ~ nivel_función, data = df, method = "bonferroni")
dunnTest(antig_m ~ nivel_función, data = df, method = "bonferroni")
# ---- 6.1 tipo_personal vs estado --------------------------------------------
tab_tipo <- table(df$estado, df$tipo_personal)
tab_tipo
chisq.test(tab_tipo)$expected
chisq.test(tab_tipo)
fisher.test(tab_tipo, simulate.p.value = TRUE, B = 10000)
# ---- 6.2 género vs estado ---------------------------------------------------
tab_gen <- table(df$estado, df$género)
tab_gen
chisq.test(tab_gen)$expected
chisq.test(tab_gen)
fisher.test(tab_gen, simulate.p.value = TRUE, B = 10000)
# ---- 6.3 contrato vs estado -------------------------------------------------
tab_con <- table(df$estado, df$contrato)
tab_con
chisq.test(tab_con)$expected
chisq.test(tab_con)
fisher.test(tab_con, simulate.p.value = TRUE, B = 10000)
# ---- 6.4 est_civil vs estado ------------------------------------------------
tab_civ <- table(df$estado, df$est_civil)
tab_civ
chisq.test(tab_civ)$expected
chisq.test(tab_civ)
fisher.test(tab_civ, simulate.p.value = TRUE, B = 10000)
# ---- 6.5 nivel_función vs estado --------------------------------------------
tab_niv <- table(df$estado, df$nivel_función)
tab_niv
chisq.test(tab_niv)$expected
chisq.test(tab_niv)
fisher.test(tab_niv, simulate.p.value = TRUE, B = 10000)
resumen_inferencial <- tibble(
Análisis = c(
"Edad — Activos vs Retirados",
"Antigüedad — Activos vs Retirados",
"Edad — por nivel de función",
"Antigüedad — por nivel de función",
"tipo_personal vs estado",
"género vs estado",
"contrato vs estado",
"est_civil vs estado",
"nivel_función vs estado"
),
Test         = NA_character_,
Estadístico  = NA_real_,
p_valor      = NA_real_,
Decisión     = NA_character_
)
resumen_inferencial %>%
kable(caption = "Resumen de pruebas inferenciales — α = 0.05") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"),
full_width = TRUE) %>%
row_spec(0, background = "#405731", color = "white", bold = TRUE)
